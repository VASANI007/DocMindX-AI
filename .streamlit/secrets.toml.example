# ============================================================
# DocMindX AI — Streamlit Cloud Secrets Template
# ============================================================
# HOW TO USE ON STREAMLIT CLOUD:
#   1. Go to your app on share.streamlit.io
#   2. Click "Settings" → "Secrets"
#   3. Copy-paste the keys below (fill in your actual values)
#   4. DO NOT put this file's real values on GitHub
#
# For LOCAL development: use .env file (already in .gitignore)
# ============================================================

# --- API Keys ---
OPENFDA_API_KEY = "your_openfda_key"
WHO_ICD_CLIENT_ID = "your_who_client_id"
WHO_ICD_CLIENT_SECRET = "your_who_client_secret"
BIOPORTAL_API_KEY = "your_bioportal_key"
GEMINI_API_KEY = "your_gemini_api_key"
GROQ_API_KEY = "your_groq_api_key"
GOOGLE_MAPS_API_KEY = "your_google_maps_key"
DATA_GOV_IN_API_KEY = "your_data_gov_key"

# --- Admin Credentials (CRITICAL for Admin Login) ---
DOCMINDX_ADMIN_EMAIL = "docmindxai@gmail.com"

# Generate hash locally with:
#   python -c "import bcrypt; print(bcrypt.hashpw(b'YourPassword', bcrypt.gensalt(12)).decode())"
DOCMINDX_ADMIN_PASSWORD_HASH = "$2b$12$AHnQC29XawVhi0zA/KoelespA2E11h7F/lZIcw6lliajKV1YwAqjW"

# --- SMTP Email Configuration ---
SMTP_HOST = "smtp.gmail.com"
SMTP_PORT = "587"
SMTP_USERNAME = "docmindxai@gmail.com"
SMTP_PASSWORD = "your_gmail_app_password"
